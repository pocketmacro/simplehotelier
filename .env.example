# Copy to js/config.js values (browser) — never commit real service keys.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Edge Functions only (set with `supabase secrets set`, never in browser code):
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# SUPABASE_SERVICE_ROLE_KEY=... (auto-present inside Edge Functions)
